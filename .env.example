# Bidwire runs fully without keys (built-in ledger + on-screen phone).
# Add Inkbox keys to make approval texts and receipts real.

# Inkbox (agent identity: SMS + email for approvals and receipts)
INKBOX_API_KEY=
# The Inkbox identity handle / agent name you created in the Inkbox console (optional)
INKBOX_IDENTITY=

# Phone number (E.164, e.g. +14155551234) that receives "approve this purchase?" texts during the demo
APPROVER_PHONE=
# Email that receives purchase receipts during the demo
RECEIPT_EMAIL=

# Presenter key for reset/bots/timing from remote devices (localhost never needs it). Random if unset.
DIRECTOR_KEY=

# Server
PORT=8787
PUBLIC_URL=http://localhost:8787
